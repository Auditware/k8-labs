# secrets/backend.env.prod.example
#
# REFERENCE ONLY - there is no real secrets/backend.env.prod file, and nothing
# reads this file. It documents, in one concrete place, the variable names and
# shapes the backend expects in a real deployment.
#
# In a cluster deployment these are NOT shipped as a file:
#   - Non-secret config (ports, DB host/name, CORS origin) comes from a Helm
#     ConfigMap (see apps/backend/).
#   - Secrets (DB password, JWT signing key, OAuth client secrets) come from
#     your secret manager at runtime - e.g. HashiCorp Vault, SOPS, or
#     Kubernetes Secrets. Do not bake secrets into container images.

PORT=8080
LOG_LEVEL=info

DATABASE_HOST=postgres.postgres.svc.cluster.local
DATABASE_PORT=5432
DATABASE_NAME=k8labs
DATABASE_SSLMODE=require

# --- From your secret manager (never committed) ---
DATABASE_USER=
DATABASE_PASSWORD=
JWT_SIGNING_KEY=            # openssl rand -hex 32

# --- Public site origin (your domain) ---
CORS_ORIGIN=https://k8labs.example.com

# --- OAuth (client IDs public; secrets from your secret manager) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
