# secrets/frontend.env.example
#
# Copy to secrets/frontend.env (gitignored). Deliberately near-empty.
#
# The frontend talks to the backend over a relative /api path in every
# environment (Vite's dev proxy locally, Traefik routing in the cluster),
# instead of an absolute API URL. That avoids a footgun: Vite's VITE_* vars
# are baked into the static bundle at BUILD time, not read at container start
# like the backend's env vars - so an absolute URL would mean a different
# image per environment instead of one image for all environments.
#
# Add VITE_* vars here only when something must differ between environments
# AND cannot be made relative.

# OAuth client IDs are meant to be public (they appear in the browser's own
# redirect URL regardless). The corresponding client SECRETS live only in
# secrets/backend.env, never here. Leave blank to disable that provider's
# button in the UI.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Optional product analytics (PostHog). Disabled unless a token is set, and
# only ever enabled in production builds. Leave blank to keep analytics off.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
