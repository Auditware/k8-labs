# secrets/ghcr.env.example
#
# Copy to secrets/ghcr.env (gitignored). Only needed if your cluster pulls the
# container images from a PRIVATE registry. If you publish images publicly (or
# build them in-cluster), you can skip this.
#
# Create a GitHub personal access token (classic) with the read:packages scope
# to pull images from GHCR.
GHCR_USER=your-github-username
GHCR_TOKEN=
