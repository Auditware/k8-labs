# secrets/argocd.env.example
#
# Copy to secrets/argocd.env (gitignored). Only needed if you deploy with
# ArgoCD and your Git repo is PRIVATE. It holds ArgoCD's repository-read
# credential, used once to create the ArgoCD repository Secret in the argocd
# namespace (see the self-hosting guide). Not consumed by any running pod.
#
# Use a fine-grained GitHub PAT with Contents: Read-only, scoped to your repo.
GITHUB_PAT=
