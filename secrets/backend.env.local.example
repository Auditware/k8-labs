# secrets/backend.env.local.example
#
# Copy to secrets/backend.env and adjust. The real secrets/backend.env is
# gitignored and must never be committed.
#
# The values below are safe dummy defaults - enough to boot the stack locally
# (docker-compose or Tilt). The only things you need to fill in are the OAuth
# client credentials, and only if you want to test Google/GitHub login - for
# local dev the username/password seed below is usually enough.

PORT=8080
LOG_LEVEL=debug

# --- Database config (not secret, environment-specific) ---
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=k8labs
DATABASE_SSLMODE=disable

# --- Secrets (local dummy values; use a real secret manager in production) ---
DATABASE_USER=k8labs
DATABASE_PASSWORD=k8labs-local-dev
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SIGNING_KEY=local-dev-only-change-me-0000000000000000000000000000000000000000

# --- CORS / OAuth ---
# Primary local dev origin (bun run dev). The redirect allowlist also always
# accepts localhost:7373 / :5173 / :8080 (see internal/accounts/redirect.go).
CORS_ORIGIN=http://localhost:7373
# Google OAuth: create a client at https://console.cloud.google.com/apis/credentials
# and add http://localhost:7373/login and http://localhost:8080/login as
# Authorized redirect URIs. Leave blank to disable Google login locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth: create an OAuth App at https://github.com/settings/developers
# with Authorization callback URL http://localhost:7373/login.
# Leave blank to disable GitHub login locally.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Username/password login (optional local admin seed) ---
# If both are set, one admin user is seeded on first startup. It never
# overwrites an already-seeded user, so a locally-changed password survives a
# restart. Handy for local dev without OAuth; leave unset in production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-local-dev

# --- Local Postgres bootstrap (docker-compose only) ---
# The official postgres image reads these exact names to create the initial
# user/db. Values must match DATABASE_USER/PASSWORD/NAME above. No prod
# equivalent: the in-cluster Postgres gets its credentials from your secret
# manager instead.
POSTGRES_USER=k8labs
POSTGRES_PASSWORD=k8labs-local-dev
POSTGRES_DB=k8labs
