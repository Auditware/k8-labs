# Variables consumed by `clusterctl generate cluster` (step 4 in README.md)
# and the CAPH controllers. REFERENCE ONLY - copy to
# secrets/clusterctl-vars.env, fill real values, and git-secret encrypt it
# (see secrets/README.md). Never commit the filled version in plaintext.

# --- Hetzner Cloud (control-plane + platform nodes) ---
# Read/write token from the Hetzner Cloud console for the k8labs project.
HCLOUD_TOKEN=

# Region + machine type for the control-plane node(s). Prod runs cx33 (4 vCPU /
# 8 GB, nbg1) - see infra/cloud/variables.tf; resize to cx43
# (8/16) under load. (Path A/CAPH is NOT the deployed path - Path B built prod -
# but keep these aligned so a future CAPH pivot reproduces the same box.)
HCLOUD_REGION=nbg1
HCLOUD_CONTROL_PLANE_MACHINE_TYPE=cx33
HCLOUD_SSH_KEY=k8labs        # name of an SSH key already uploaded to hcloud

# --- Hetzner Robot (bare-metal labs node - the AX41) ---
# Robot webservice user + password (NOT your main login - create a dedicated
# webservice user in Robot). The AX41 must already be ordered (manual) and its
# server number known.
HETZNER_ROBOT_USER=
HETZNER_ROBOT_PASSWORD=
HETZNER_BAREMETAL_SERVER_ID=      # the AX41's server number from Robot
# SSH key CAPH uses to drive the rescue system during OS provisioning.
HETZNER_SSH_PUB_PATH=secrets/k8labs-robot.pub
HETZNER_SSH_PRIV_PATH=secrets/k8labs-robot

# --- Cluster shape ---
CLUSTER_NAME=k8labs
KUBERNETES_VERSION=v1.31.4
CONTROL_PLANE_MACHINE_COUNT=1
# Workers come from the bare-metal AX41, added as a separate MachineDeployment
# (see README.md step 4) - not from this hcloud worker count.
WORKER_MACHINE_COUNT=0
